+"""Persistence, resizing and mixed native units for pose geometry."""
+
+import cv2
+import numpy as np
+import pytest
+from sidecar_rs import SidecarDocument
+
+from meta_pose.coordinates import to_normalized
+from meta_pose.coordinate_migration import migrate_document
+from meta_pose.sidecar_io import read_pose_result, write_pose_result
+
+
+def test_pose_normalized_storage_and_resize(tmp_path):
+    path = tmp_path / 'pose.png'
+    cv2.imwrite(str(path), np.zeros((200, 400, 3), dtype=np.uint8))
+    result = {'native': {'detections': [{'keypoints': [{'x': 100, 'y': 60, 'score': .9}]}]},
+              'keypoints': [[{'name': 'nose', 'x': 100, 'y': 60, 'score': .9}]],
+              'bboxes': [[80, 40, 200, 180]], 'model': 'test', 'version': '1', 'created': 'original'}
+    scar = write_pose_result(path, 'yolo', result)
+    doc = SidecarDocument.from_path(scar)
+    assert doc['pose.yolo.keypoints'][0][0]['x'] == .25
+    assert doc['pose.yolo.keypoints'][0][0]['y'] == .3
+    assert doc['pose.yolo.native']['detections'][0]['keypoints'][0]['x'] == .25
+    cv2.imwrite(str(path), np.zeros((50, 200, 3), dtype=np.uint8))
+    read = read_pose_result(path, 'yolo')
+    assert read['keypoints'][0][0] == {'name': 'nose', 'x': 50, 'y': 15, 'score': .9}
+    assert read['bboxes'] == [[40, 10, 100, 45]]
+    from meta_pose.annotate import draw_pose
+
+    assert draw_pose(np.zeros((50, 200, 3), dtype=np.uint8), read).shape == (50, 200, 3)
+
+
+def test_mediapipe_native_pixels_and_depth():
+    # The backend converts MediaPipe x/y to pixels before building native output.
+    source = {'native': {'poses': [{'landmarks': [{'x': 100, 'y': 60, 'z': -.1, 'visibility': .9}]}]},
+              'keypoints': [[{'name': 'nose', 'x': 100, 'y': 60, 'score': .9}]], 'bboxes': []}
+    result = to_normalized(source, (400, 200), tool='mediapipe')
+    assert result['native']['poses'][0]['landmarks'][0] == {'x': .25, 'y': .3, 'z': -.1, 'visibility': .9}
+    assert result['keypoints'][0][0]['x'] == .25
+    assert to_normalized(result, (800, 400), tool='mediapipe') == result
+
+
+def test_migration_requires_original_size_and_preserves_face():
+    doc = SidecarDocument()
+    doc.set('pose.yolo.keypoints', [[{'x': 100, 'y': 60, 'score': .9}]])
+    doc.set('pose.yolo.bbox', [[80, 40, 200, 180]])
+    doc.set('pose.yolo.created', 'original')
+    doc.set('face.scrfd.faces', [{'bbox': [1, 2, 3, 4]}])
+    assert migrate_document(doc)['missing_size'] == ['yolo']
+    migrate_document(doc, write=True, source_size=(400, 200))
+    assert doc['pose.yolo.bbox'] == [[.2, .2, .5, .9]]
+    assert doc['pose.yolo.created'] == 'original'
+    assert doc['face.scrfd.faces'] == [{'bbox': [1, 2, 3, 4]}]
+
+
+def test_clamp_canonical_native_and_boxes_preserving_depth_and_scores():
+    from meta_pose.coordinates import to_pixels
+
+    source = {'native': {'poses': [{'landmarks': [
+        {'x': -4, 'y': 210, 'z': -.2, 'visibility': .9},
+        {'x': 420, 'y': -10, 'z': 2, 'visibility': .4}]}],
+        'world_landmarks': [{'x': -2, 'y': 3, 'z': 5}]},
+        'keypoints': [[{'x': -4, 'y': 210, 'score': .9}, {'x': 420, 'y': -10, 'score': .4}]],
+        'bboxes': [[-20, -10, 420, 210]], 'pose': [-30, 60, 180]}
+    result = to_normalized(source, (400, 200), tool='mediapipe')
+    assert result['coordinates']['schema'] == 2
+    assert result['coordinates']['unit'] == 'normalized'
+    assert result['keypoints'][0] == [{'x': 0, 'y': 1, 'score': .9}, {'x': 1, 'y': 0, 'score': .4}]
+    assert result['bboxes'] == [[0, 0, 1, 1]]
+    assert result['native']['poses'][0]['landmarks'] == [
+        {'x': 0, 'y': 1, 'z': -.2, 'visibility': .9}, {'x': 1, 'y': 0, 'z': 2, 'visibility': .4}]
+    assert result['native']['world_landmarks'] == source['native']['world_landmarks']
+    assert result['pose'] == source['pose']
+    assert to_normalized(result, tool='mediapipe') == result
+    pixels = to_pixels(result, (200, 50))
+    assert pixels['bboxes'] == [[0, 0, 200, 50]]
+    assert pixels['keypoints'][0][0] == {'x': 0, 'y': 50, 'score': .9}
+    assert source['keypoints'][0][0]['x'] == -4
+
+
+def test_schema_1_migration_and_reader_without_original_size(tmp_path):
+    path = tmp_path / 'pose.png'
+    doc = SidecarDocument()
+    doc.set('pose.yolo.coordinates', {'schema': 1, 'unit': 'percent', 'space': 'image'})
+    doc.set('pose.yolo.native_coordinates', {'schema': 1, 'unit': 'percent', 'space': 'image', 'z_unit': 'native'})
+    doc.set('pose.yolo.native', {'detections': [{'keypoints': [{'x': -5, 'y': 120, 'score': .9}]}]})
+    doc.set('pose.yolo.keypoints', [[{'x': -5, 'y': 120, 'score': .9}]])
+    doc.set('pose.yolo.bbox', [[-5, 20, 105, 80]])
+    doc.set('pose.yolo.created', 'original')
+    # Read the old representation directly before migrating it.
+    doc.to_path(path.with_suffix('.scar'))
+    read = read_pose_result(path, 'yolo', image_size=(400, 200))
+    assert read['keypoints'][0][0] == {'x': 0, 'y': 200, 'score': .9}
+    assert read['bboxes'] == [[0, 40, 400, 160]]
+    assert migrate_document(doc)['converted'] == ['yolo']
+    assert doc['pose.yolo.coordinates']['unit'] == 'percent'
+    migrate_document(doc, write=True)
+    assert doc['pose.yolo.keypoints'][0][0] == {'x': 0, 'y': 1, 'score': .9}
+    assert doc['pose.yolo.native']['detections'][0]['keypoints'][0]['y'] == 1
+    assert doc['pose.yolo.bbox'] == [[0, .2, 1, .8]]
+    assert doc['pose.yolo.created'] == 'original'
+    assert 'pose.yolo.image_size' not in doc
+    assert migrate_document(doc)['already_normalized'] == ['yolo']
+    doc.set('pose.yolo.keypoints', [[{'x': 1.4, 'y': -.2, 'score': .9}]])
+    assert migrate_document(doc, write=True)['converted'] == ['yolo']
+    assert doc['pose.yolo.keypoints'][0][0] == {'x': 1, 'y': 0, 'score': .9}
+
+
+def test_point_rows_and_legacy_pixel_resize():
+    from meta_pose.coordinates import to_pixels
+
+    source = {'native': {'instances': [{'bbox': [-4, 10, 420, 190], 'keypoints': [[-4, 210, .9], [400, 0, .7]]}]},
+              'keypoints': [], 'bboxes': [], 'image_size': [400, 200]}
+    result = to_normalized(source, tool='mmpose')
+    assert result['native']['instances'][0]['bbox'] == pytest.approx([0, .05, 1, .95])
+    assert result['native']['instances'][0]['keypoints'] == [[0, 1, .9], [1, 0, .7]]
+    pixels = to_pixels(source, (200, 50))
+    assert pixels['native']['instances'][0]['keypoints'] == [[0, 50, .9], [200, 0, .7]]
+
+
+def test_nonfinite_positions_are_rejected():
+    for value in (float('nan'), float('inf'), float('-inf')):
+        with pytest.raises(ValueError, match='finite'):
+            to_normalized({'keypoints': [[{'x': value, 'y': 10}]]}, (400, 200), tool='yolo')
