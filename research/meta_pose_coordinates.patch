+"""Image geometry normalized to [0, 1]; confidence and native depth keep their units."""
+
+from __future__ import annotations
+
+import copy
+import math
+from typing import Any
+
+COORDINATES = {"schema": 2, "unit": "normalized", "space": "image",
+               "x_reference": "width", "y_reference": "height"}
+RELATIVE_UNITS = {"normalized", "percent"}  # Schema 1 remains readable.
+
+
+def _size(size: Any) -> tuple[float, float]:
+    w, h = map(float, size)
+    if not all(math.isfinite(v) and v > 0 for v in (w, h)):
+        raise ValueError("Original image dimensions must be finite and positive")
+    return w, h
+
+
+def _factors(unit: str | None, size: Any) -> tuple[float, float]:
+    if unit == "normalized":
+        return 1.0, 1.0
+    if unit == "percent":
+        return .01, .01
+    if unit not in {None, "pixels"}:
+        raise ValueError(f"Unknown image coordinate unit: {unit}")
+    if size is None:
+        raise ValueError("Original image dimensions are required for pixel coordinates")
+    w, h = _size(size)
+    return 1 / w, 1 / h
+
+
+def _position(value: Any, factor: float, clamp: bool) -> Any:
+    if value is None:
+        return None
+    value *= factor
+    if not math.isfinite(value):
+        raise ValueError("Image coordinates must be finite")
+    return max(0.0, min(1.0, value)) if clamp else value
+
+
+def _transform(value: Any, fx: float, fy: float, *, clamp: bool, points: bool = False) -> Any:
+    if isinstance(value, list):
+        if points and len(value) >= 2 and all(v is None or isinstance(v, (int, float)) for v in value):
+            return [_position(value[0], fx, clamp), _position(value[1], fy, clamp), *value[2:]]
+        return [_transform(item, fx, fy, clamp=clamp, points=points) for item in value]
+    if not isinstance(value, dict):
+        return value
+    result = dict(value)
+    for key, item in value.items():
+        if "world" in key or key in {"pose", "coordinates", "native_coordinates"}:
+            result[key] = copy.deepcopy(item)
+        elif key in {"bbox", "bboxes"} and isinstance(item, list):
+            boxes = item if key == "bboxes" else [item]
+            converted = [[_position(v, fx if i % 2 == 0 else fy, clamp) if i < 4 else v
+                          for i, v in enumerate(box)] for box in boxes]
+            result[key] = converted if key == "bboxes" else converted[0]
+        elif points and key in {"x", "y"} and (item is None or isinstance(item, (int, float))):
+            result[key] = _position(item, fx if key == "x" else fy, clamp)
+        else:
+            result[key] = _transform(item, fx, fy, clamp=clamp,
+                                     points=points or key in {"landmarks", "keypoints", "kps"})
+    return result
+
+
+def to_normalized(result: dict[str, Any], image_size: Any = None, *, tool: str) -> dict[str, Any]:
+    """Normalize pixels or schema 1 coordinates and clamp all image x/y values."""
+    unit = result.get("coordinates", {}).get("unit")
+    size = result.get("image_size") if unit in RELATIVE_UNITS else image_size or result.get("image_size")
+    if size is None:
+        size = image_size
+    if size is not None:
+        _size(size)
+    fx, fy = _factors(unit, size)
+    output = _transform(result, fx, fy, clamp=True)
+    native_unit = result.get("native_coordinates", {}).get("unit", unit)
+    if native_unit != unit and "native" in result:
+        output["native"] = _transform(result["native"], *_factors(native_unit, size), clamp=True)
+    output["coordinates"] = {**result.get("coordinates", {}), **COORDINATES}
+    output["native_coordinates"] = {**result.get("native_coordinates", {}), **COORDINATES, "z_unit": "native"}
+    if size is not None:
+        output["image_size"] = [int(v) for v in _size(size)]
+    return output
+
+
+def to_pixels(result: dict[str, Any], image_size: Any) -> dict[str, Any]:
+    w, h = _size(image_size)
+    if result.get("coordinates", {}).get("unit") not in RELATIVE_UNITS and not result.get("image_size"):
+        return copy.deepcopy(result)
+    output = _transform(to_normalized(result, tool=""), w, h, clamp=False)
+    output["coordinates"] = {"schema": 2, "unit": "pixels", "space": "image"}
+    output["native_coordinates"] = {"schema": 2, "unit": "pixels", "space": "image", "z_unit": "native"}
+    output["image_size"] = [int(w), int(h)]
+    return output
