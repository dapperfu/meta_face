+"""Migrate stored pose coordinates without rerunning detection."""
+
+from pathlib import Path
+
+import click
+from sidecar_rs import SidecarDocument
+
+from meta_pose.coordinates import RELATIVE_UNITS, to_normalized
+
+
+def migrate_document(doc, *, write=False, source_size=None):
+    entries = doc.entries()
+    tools = sorted({key.split('.')[1] for key in entries
+                    if key.startswith('pose.') and key.endswith('.keypoints')})
+    report = {'converted': [], 'already_normalized': [], 'missing_size': []}
+    for tool in tools:
+        prefix = f'pose.{tool}.'
+        result = {key[len(prefix):]: value for key, value in entries.items() if key.startswith(prefix)}
+        size = result.get('image_size') or source_size
+        if size is None and result.get('coordinates', {}).get('unit') not in RELATIVE_UNITS:
+            report['missing_size'].append(tool)
+            continue
+        original = dict(result)
+        result['bboxes'] = result.pop('bbox', [])
+        result = to_normalized(result, size, tool=tool)
+        result['bbox'] = result.pop('bboxes')
+        if result == original:
+            report['already_normalized'].append(tool)
+            continue
+        if write:
+            for field, value in result.items():
+                doc.set(prefix + field, value)
+        report['converted'].append(tool)
+    return report
+
+
+@click.command('normalize-coordinates')
+@click.argument('path', type=click.Path(exists=True, path_type=Path))
+@click.option('--write', is_flag=True)
+@click.option('--source-size', nargs=2, type=click.IntRange(min=1), default=None,
+              help='Known original WIDTH HEIGHT for legacy records without image_size.')
+def normalize_coordinates(path, write, source_size):
+    """Preview or migrate pose sidecars to clamped normalized image coordinates."""
+    paths = sorted(path.rglob('*.scar')) if path.is_dir() else [path.with_suffix('.scar')]
+    totals = {'converted': 0, 'already_normalized': 0, 'missing_size': 0}
+    try:
+        for scar in paths:
+            if not scar.is_file():
+                raise FileNotFoundError(f'No existing sidecar: {scar}')
+            if write:
+                reports = []
+
+                def patch(doc):
+                    reports.append(migrate_document(doc, write=True, source_size=source_size))
+
+                SidecarDocument.update_path(scar, patch)
+                report = reports[0]
+            else:
+                report = migrate_document(SidecarDocument.from_path(scar), source_size=source_size)
+            for key in totals:
+                totals[key] += len(report[key])
+            if report['missing_size']:
+                click.echo(f"{scar}: original dimensions needed for {', '.join(report['missing_size'])}", err=True)
+        verb = 'Converted' if write else 'Would convert'
+        click.echo(f"{verb} {totals['converted']} sections; {totals['already_normalized']} already normalized; "
+                   f"{totals['missing_size']} need original dimensions.")
+    except Exception as exc:
+        raise click.ClickException(str(exc)) from exc
